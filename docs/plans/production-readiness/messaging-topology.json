{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": 1,
  "endpointNameFormatter": "kebab-case",
  "scheduler": {
    "RabbitMq": { "strategy": "Quartz", "endpoint": "quartz" },
    "AzureServiceBus": { "strategy": "Native" }
  },
  "commands": [
    "Domain.Common.Commands.Basket.EmptyBasketCommand",
    "Domain.Common.Commands.Basket.ReinstateBasketCommand",
    "Domain.Common.Commands.Operations.PreparePackageCommand",
    "Domain.Common.Commands.Operations.StartOrderPreparationCommand",
    "Domain.Common.Commands.Orders.CancelOrderCommand",
    "Domain.Common.Commands.Orders.CompleteOrderCommand",
    "Domain.Common.Commands.Orders.ExpireOrderCommand",
    "Domain.Common.Commands.Orders.FailOrderCommand",
    "Domain.Common.Commands.Orders.UpdateOrderStatusCommand",
    "Domain.Common.Commands.Payments.RefundPaymentCommand",
    "Domain.Common.Commands.Shipping.CancelShippingCommand",
    "Domain.Common.Commands.Shipping.ConfirmPickupCommand",
    "Domain.Common.Commands.Shipping.ScheduleShippingCommand",
    "Domain.Common.Commands.Stock.CommitStockReservationCommand",
    "Domain.Common.Commands.Stock.ReleaseStockReservationCommand"
  ],
  "events": [
    "Domain.Common.Events.Customers.CustomerAddressUpdatedEvent",
    "Domain.Common.Events.Operations.PackageIssueReportedEvent",
    "Domain.Common.Events.Orders.OrderCancelledEvent",
    "Domain.Common.Events.Orders.OrderCompletedEvent",
    "Domain.Common.Events.Orders.OrderConfirmedEvent",
    "Domain.Common.Events.Orders.OrderDeliveredEvent",
    "Domain.Common.Events.Orders.OrderExpiredEvent",
    "Domain.Common.Events.Orders.OrderFailedEvent",
    "Domain.Common.Events.Orders.OrderPaymentCompletedEvent",
    "Domain.Common.Events.Orders.OrderPaymentFailedEvent",
    "Domain.Common.Events.Orders.OrderReadyForPickupEvent",
    "Domain.Common.Events.Orders.OrderSellerSaleRegistrationRequestedEvent",
    "Domain.Common.Events.Orders.OrderShippedEvent",
    "Domain.Common.Events.Orders.OrderStatusUpdatedEvent",
    "Domain.Common.Events.Orders.OrderSubmittedEvent",
    "Domain.Common.Events.Payments.PaymentCompletedEvent",
    "Domain.Common.Events.Payments.PaymentFailedEvent",
    "Domain.Common.Events.Payments.PaymentInitiatedEvent",
    "Domain.Common.Events.Payments.PaymentRefundedEvent",
    "Domain.Common.Events.Products.ProductPublishedEvent",
    "Domain.Common.Events.Products.ProductUpdatedEvent",
    "Domain.Common.Events.Sellers.SellerRegistrationRequestedEvent",
    "Domain.Common.Events.Sellers.SellerSaleRegisteredEvent",
    "Domain.Common.Events.Sellers.SellerTaxVerificationRequestedEvent",
    "Domain.Common.Events.Sellers.SellerVerificationCompletedEvent",
    "Domain.Common.Events.Shipping.ShippingCompletedEvent",
    "Domain.Common.Events.Shipping.ShippingFailedEvent",
    "Domain.Common.Events.Shipping.ShippingPickupConfirmedEvent",
    "Domain.Common.Events.Shipping.ShippingScheduledEvent",
    "Domain.Common.Events.Stock.ProductOutOfStockEvent",
    "Domain.Common.Events.Stock.StockReleasedEvent",
    "Domain.Common.Events.Stock.StockReservationCommitFailedEvent",
    "Domain.Common.Events.Stock.StockReservationCommittedEvent",
    "Domain.Common.Events.Stock.StockReservationCreatedEvent",
    "Domain.Common.Events.Stock.StockUpdatedEvent"
  ],
  "consumers": [
    { "type": "Basket.EventsProcessor.Consumers.ProductsEventConsumer", "endpoint": "products-updated" },
    { "type": "Basket.EventsProcessor.Consumers.StockEventConsumer", "endpoint": "stock-updated" },
    { "type": "Basket.EventsProcessor.Consumers.EmptyBasketCommandConsumer", "endpoint": "empty-basket" },
    { "type": "Basket.EventsProcessor.Consumers.ReinstateBasketCommandConsumer", "endpoint": "reinstate-basket" },
    { "type": "Customers.Messaging.Consumers.CustomerAddressUpdatedEventConsumer", "endpoint": "customer-address-updated-event" },
    { "type": "NotificationService.OrderNotificationConsumer", "endpoint": "order-notification" },
    { "type": "NotificationService.SellerNotificationConsumer", "endpoint": "seller-notification" },
    { "type": "Operations.Service.Consumers.PreparePackageCommandConsumer", "endpoint": "prepare-package" },
    { "type": "Operations.Service.Consumers.PackageSellerStampConsumer", "endpoint": "operations-seller-stamp" },
    { "type": "API.Sse.OrderStatusUpdatedSseConsumer", "endpoint": "order-status-updated-sse" },
    { "type": "Orders.Messaging.Consumers.CancelOrderCommandConsumer", "endpoint": "cancel-order-command" },
    { "type": "Orders.Messaging.Consumers.UpdateOrderStatusCommandConsumer", "endpoint": "update-order-status-command" },
    { "type": "Payments.Messaging.Consumers.RefundPaymentCommandConsumer", "endpoint": "refund-payment" },
    { "type": "Sellers.Service.Consumers.OrderSubmittedForSellerConsumer", "endpoint": "seller-orders-submitted" },
    { "type": "Sellers.Service.Consumers.SellerDocumentVerificationConsumer", "endpoint": "seller-document-verification" },
    { "type": "Sellers.Service.Consumers.SellerTaxBillingVerificationConsumer", "endpoint": "seller-tax-billing-verification" },
    { "type": "Sellers.EventsProcessor.Consumers.OrderSellerSaleRegistrationRequestedConsumer", "endpoint": "seller-sale-registration-requested" },
    { "type": "Shipping.Service.Consumers.ScheduleShippingCommandConsumer", "endpoint": "schedule-shipping" },
    { "type": "Shipping.Service.Consumers.CancelShippingCommandConsumer", "endpoint": "cancel-shipping" },
    { "type": "Shipping.Service.Consumers.OrderDeliveredEventConsumer", "endpoint": "order-delivered" },
    { "type": "Shipping.Service.Consumers.ConfirmPickupCommandConsumer", "endpoint": "confirm-shipping" },
    { "type": "Stock.Messaging.Processor.Consumers.CommitStockReservationConsumer", "endpoint": "commit-stock-reservation" },
    { "type": "Stock.Messaging.Processor.Consumers.ReleaseStockReservationConsumer", "endpoint": "release-stock-reservation" },
    { "type": "Stock.Messaging.Processor.Consumers.ProductPublishedConsumer", "endpoint": "product-published-stock" }
  ],
  "sagas": [
    { "type": "Application.Saga.OrderStateMachine", "endpoint": "order-state", "persistence": "EntityFrameworkCore" }
  ],
  "endpoints": [
    { "name": "products-updated", "owner": "Basket.EventsProcessor", "durable": true, "subscriptions": ["Domain.Common.Events.Products.ProductUpdatedEvent"] },
    { "name": "stock-updated", "owner": "Basket.EventsProcessor", "durable": true, "subscriptions": ["Domain.Common.Events.Stock.StockUpdatedEvent"] },
    { "name": "empty-basket", "owner": "Basket.EventsProcessor", "durable": true, "commands": ["Domain.Common.Commands.Basket.EmptyBasketCommand"] },
    { "name": "reinstate-basket", "owner": "Basket.EventsProcessor", "durable": true, "commands": ["Domain.Common.Commands.Basket.ReinstateBasketCommand"] },
    { "name": "customer-address-updated-event", "owner": "Customers.Messaging", "durable": true, "subscriptions": ["Domain.Common.Events.Customers.CustomerAddressUpdatedEvent"] },
    { "name": "order-notification", "owner": "Notifications.Service", "durable": true, "subscriptions": ["Domain.Common.Events.Orders.OrderSubmittedEvent", "Domain.Common.Events.Orders.OrderStatusUpdatedEvent"] },
    { "name": "seller-notification", "owner": "Notifications.Service", "durable": true, "subscriptions": ["Domain.Common.Events.Sellers.SellerVerificationCompletedEvent"] },
    { "name": "prepare-package", "owner": "Operations.Service", "durable": true, "commands": ["Domain.Common.Commands.Operations.PreparePackageCommand"] },
    { "name": "operations-seller-stamp", "owner": "Operations.Service", "durable": true, "subscriptions": ["Domain.Common.Events.Orders.OrderSellerSaleRegistrationRequestedEvent"] },
    { "name": "order-status-updated-sse", "owner": "Orders.API", "durable": true, "subscriptions": ["Domain.Common.Events.Orders.OrderStatusUpdatedEvent"] },
    { "name": "cancel-order-command", "owner": "Orders.Messaging", "durable": true, "commands": ["Domain.Common.Commands.Orders.CancelOrderCommand"] },
    { "name": "update-order-status-command", "owner": "Orders.Messaging", "durable": true, "commands": ["Domain.Common.Commands.Orders.UpdateOrderStatusCommand"] },
    { "name": "order-state", "owner": "Orchestration", "durable": true, "saga": "Application.Saga.OrderStateMachine", "subscriptions": ["Domain.Common.Events.Orders.OrderSubmittedEvent", "Domain.Common.Events.Orders.OrderCompletedEvent", "Domain.Common.Events.Payments.PaymentCompletedEvent", "Domain.Common.Events.Payments.PaymentFailedEvent", "Domain.Common.Events.Stock.StockReservationCommittedEvent", "Domain.Common.Events.Stock.StockReservationCommitFailedEvent", "Domain.Common.Events.Orders.OrderReadyForPickupEvent", "Domain.Common.Events.Operations.PackageIssueReportedEvent", "Domain.Common.Events.Shipping.ShippingFailedEvent", "Domain.Common.Events.Shipping.ShippingScheduledEvent", "Domain.Common.Events.Orders.OrderShippedEvent", "Domain.Common.Events.Orders.OrderDeliveredEvent", "Domain.Common.Events.Orders.OrderExpiredEvent"] },
    { "name": "refund-payment", "owner": "Payments.Messaging", "durable": true, "commands": ["Domain.Common.Commands.Payments.RefundPaymentCommand"] },
    { "name": "seller-orders-submitted", "owner": "Sellers.Service", "durable": true, "subscriptions": ["Domain.Common.Events.Orders.OrderSubmittedEvent"] },
    { "name": "seller-document-verification", "owner": "Sellers.Service", "durable": true, "subscriptions": ["Domain.Common.Events.Sellers.SellerRegistrationRequestedEvent"] },
    { "name": "seller-tax-billing-verification", "owner": "Sellers.Service", "durable": true, "subscriptions": ["Domain.Common.Events.Sellers.SellerTaxVerificationRequestedEvent"] },
    { "name": "seller-sale-registration-requested", "owner": "Sellers.EventsProcessor", "durable": true, "subscriptions": ["Domain.Common.Events.Orders.OrderSellerSaleRegistrationRequestedEvent"] },
    { "name": "schedule-shipping", "owner": "Shipping.Service", "durable": true, "commands": ["Domain.Common.Commands.Shipping.ScheduleShippingCommand"] },
    { "name": "cancel-shipping", "owner": "Shipping.Service", "durable": true, "commands": ["Domain.Common.Commands.Shipping.CancelShippingCommand"] },
    { "name": "order-delivered", "owner": "Shipping.Service", "durable": true, "subscriptions": ["Domain.Common.Events.Orders.OrderDeliveredEvent"] },
    { "name": "confirm-shipping", "owner": "Shipping.Service", "durable": true, "commands": ["Domain.Common.Commands.Shipping.ConfirmPickupCommand"] },
    { "name": "commit-stock-reservation", "owner": "Stock.Messaging.Processor", "durable": true, "commands": ["Domain.Common.Commands.Stock.CommitStockReservationCommand"] },
    { "name": "release-stock-reservation", "owner": "Stock.Messaging.Processor", "durable": true, "commands": ["Domain.Common.Commands.Stock.ReleaseStockReservationCommand"] },
    { "name": "product-published-stock", "owner": "Stock.Messaging.Processor", "durable": true, "subscriptions": ["Domain.Common.Events.Products.ProductPublishedEvent"] }
  ],
  "publishedCommandExceptions": [
    { "contract": "Domain.Common.Commands.Orders.CompleteOrderCommand", "reason": "No consuming endpoint exists in the repository." }
  ]
}
