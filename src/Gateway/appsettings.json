{
"Logging": {
  "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Warning",
    "Yarp.ReverseProxy": "Information"
  }
},
"AllowedHosts": "*",
"ReverseProxy": {
  "Routes": {
    "products-route": {
      "ClusterId": "products-api",

      "Match": {
        "Path": "/api/products/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/products" },
        { "PathPrefix": "/api/product" }
      ]
    },
    "basket-route": {
      "ClusterId": "basket-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/basket/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/basket" },
        { "PathPrefix": "/basket" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "orders-stream-route": {
      "ClusterId": "orders-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/orders/{id}/stream"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/orders" },
        { "PathPrefix": "/Orders" }
      ]
    },
    "orders-route": {
      "ClusterId": "orders-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/orders/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/orders" },
        { "PathPrefix": "/Orders" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "customers-route": {
      "ClusterId": "customers-api",
      "AuthorizationPolicy": "admin",

      "Match": {
        "Path": "/api/customers/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/customers" },
        { "PathPrefix": "/customers" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "customer-self-route": {
      "ClusterId": "customers-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/me/customer/{**catch-all}",
        "Methods": [ "GET", "POST", "PUT" ]
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/me/customer" },
        { "PathPrefix": "/customers" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "shipping-status-route": {
      "ClusterId": "shipping-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/shipping/{orderId}/history",
        "Methods": [ "GET" ]
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/shipping" },
        { "PathPrefix": "/api/shipping" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "shipping-route": {
      "ClusterId": "shipping-api",
      "AuthorizationPolicy": "admin",

      "Match": {
        "Path": "/api/shipping/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/shipping" },
        { "PathPrefix": "/api/shipping" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "operations-seller-route": {
      "ClusterId": "operations-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/operations/seller/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/operations/seller" },
        { "PathPrefix": "/api/operations/seller" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "operations-route": {
      "ClusterId": "operations-api",
      "AuthorizationPolicy": "admin",

      "Match": {
        "Path": "/api/operations/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/operations" },
        { "PathPrefix": "/api/operations" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "payments-route": {
      "ClusterId": "payments-api",
      "AuthorizationPolicy": "admin",

      "Match": {
        "Path": "/api/payments/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/payments" },
        { "PathPrefix": "/api/payments" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "notifications-route": {
      "ClusterId": "notification-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/notifications/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/notifications" },
        { "PathPrefix": "/notifications" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "sellers-route": {
      "ClusterId": "sellers-api",
      "AuthorizationPolicy": "consumer",

      "Match": {
        "Path": "/api/sellers/{**catch-all}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/sellers" },
        { "PathPrefix": "/api/sellers" }
      ],
      "RateLimiterPolicy": "fixed"
    },
    "stock-route": {
      "ClusterId": "stock-api",

      "Match": {
        "Path": "/api/stock/{**catch-all}",
        "Methods": [ "GET" ]
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/stock" },
        { "PathPrefix": "/api/stock" }
      ],
      "RateLimiterPolicy": "fixed"
    }
  },
    "Clusters": {
      "products-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_products-api.eshopacademy-products-api"
          }
        }
      },
      "basket-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_basket-api.eshopacademy-basket-api"
          }
        }
      },
      "orders-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_orders-api.eshopacademy-orders-api"
          }
        }
      },
      "customers-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_customers-api.eshopacademy-customers-api"
          }
        }
      },
      "shipping-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_shipping-api.eshopacademy-shipping-api"
          }
        }
      },
      "operations-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_operations-api.eshopacademy-operations-api"
          }
        }
      },
      "payments-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_payments-api.eshopacademy-payments-api"
          }
        }
      },
      "notification-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_notification-api.eshopacademy-notification-api"
          }
        }
      },
      "sellers-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_sellers-api.eshopacademy-sellers-api"
          }
        }
      },
      "stock-api": {
        "Destinations": {
          "primary": {
            "Address": "http://_stock-api.eshopacademy-stock-api"
          }
        }
      }
    }
  }
}
